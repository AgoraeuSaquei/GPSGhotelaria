# OpenRouteService API key with directions:foot-walking enabled.
# Keep this key out of Git. For production, use a server-side proxy or a provider plan
# whose browser-key policy and rate limits permit the intended deployment.
VITE_ORS_API_KEY=
VITE_ORS_BASE_URL=https://api.openrouteservice.org/v2/directions/foot-walking/geojson
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
